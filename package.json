{
  "name": "soybean-admin-antd",
  "type": "module",
  "version": "1.3.11",
  "description": "A fresh and elegant admin template, based on Vue3,Vite3,TypeScript,AntDesign and UnoCSS.",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "license": "MIT",
  "homepage": "https://github.com/soybeanjs/soybean-admin-antd",
  "repository": {
    "url": "https://github.com/soybeanjs/soybean-admin-antd.git"
  },
  "bugs": {
    "url": "https://github.com/soybeanjs/soybean-admin-antd/issues"
  },
  "keywords": [
    "Vue3 admin ",
    "vue-admin-template",
    "Vite5",
    "TypeScript",
    "naive-ui",
    "naive-ui-admin",
    "ant-design-vue v4",
    "UnoCSS"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26",
    "pnpm": ">=10.5.0"
  },
  "scripts": {
    "build": "vite build --mode prod",
    "build:test": "vite build --mode test",
    "cleanup": "sa cleanup",
    "commit": "sa git-commit",
    "commit:zh": "sa git-commit -l=zh-cn",
    "dev": "vite --mode test",
    "dev:prod": "vite --mode prod",
    "gen-route": "sa gen-route",
    "lint": "oxlint --fix && eslint --fix .",
    "lint:check": "oxlint && eslint .",
    "prepare": "simple-git-hooks",
    "preview": "vite preview",
    "release": "sa release",
    "test:e2e": "playwright test",
    "test:unit": "node --import tsx --test tests/*.test.mjs",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "update-pkg": "sa update-pkg"
  },
  "dependencies": {
    "@better-scroll/core": "2.5.1",
    "@iconify/vue": "5.0.3",
    "@sa/axios": "workspace:*",
    "@sa/color": "workspace:*",
    "@sa/fetch": "workspace:*",
    "@sa/hooks": "workspace:*",
    "@sa/materials": "workspace:*",
    "@sa/utils": "workspace:*",
    "@vueuse/core": "15.0.0",
    "ant-design-vue": "4.2.6",
    "clipboard": "2.0.11",
    "dayjs": "1.11.23",
    "defu": "6.1.7",
    "echarts": "6.1.0",
    "json5": "2.2.3",
    "nprogress": "0.2.0",
    "pinia": "4.0.3",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.43",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "11.4.13",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@elegant-router/vue": "0.3.8",
    "@iconify/json": "2.2.540",
    "@playwright/test": "1.64.0",
    "@sa/scripts": "workspace:*",
    "@sa/uno-preset": "workspace:*",
    "@soybeanjs/eslint-config-vue": "0.1.1",
    "@types/node": "26.6.4",
    "@types/nprogress": "0.2.3",
    "@unocss/preset-icons": "66.10.5",
    "@unocss/preset-uno": "66.10.5",
    "@unocss/transformer-directives": "66.10.5",
    "@unocss/transformer-variant-group": "66.10.5",
    "@unocss/vite": "66.10.5",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "lint-staged": "17.6.0",
    "oxlint": "1.87.0",
    "sass": "1.105.1",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unplugin-icons": "24.0.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.4",
    "vite-plugin-progress": "0.0.7",
    "vite-plugin-vue-devtools": "8.2.1",
    "vite-svg-loader": "5.1.3",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm sa git-commit-verify",
    "pre-commit": "pnpm typecheck && pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,cts,mts,tsx,jsx,vue}": [
      "oxlint --fix",
      "eslint --fix --no-warn-ignored"
    ]
  },
  "website": "https://antd.soybeanjs.cn",
  "packageManager": "pnpm@10.34.6"
}
